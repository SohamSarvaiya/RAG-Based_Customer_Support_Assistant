# Comma-separated list of valid API keys (clients send them in the X-API-Key header)
API_KEYS=change-me-123
# LLM provider: auto | anthropic | openai | gemini | ollama | none
#   auto = uses whichever API key below is filled (Anthropic, then OpenAI, then Gemini); no key = retrieval-only
LLM_PROVIDER=auto
# Fill ONE of these (client's own key):
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional model overrides
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
LLM_MODEL=claude-sonnet-5-5
# Embeddings: sentence-transformers (local, free) | hash (tests only)
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_PATH=./data/chroma
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=4
# Minimum cosine similarity; below this the bot refuses to answer (anti-hallucination)
MIN_SCORE=0.30
MAX_UPLOAD_MB=20
